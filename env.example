# Supabase Configuration
# Получите эти значения из вашего Supabase проекта: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sheets — расписание смен (CSV export)
# Вариант 1: полный URL экспорта CSV
# GOOGLE_SCHEDULE_CSV_URL=https://docs.google.com/spreadsheets/d/XXXX/export?format=csv&gid=0
#
# Вариант 2: ID таблицы (таблица должна быть «Все, у кого есть ссылка» → Читатель)
# GOOGLE_SCHEDULE_SHEET_ID=your_spreadsheet_id
# GOOGLE_SCHEDULE_SHEET_GID=0
#
# Формат листа (первая строка — заголовки):
# дата | админ | тип
# 2026-07-26 | Сергей | день
# 26.07.2026 | Иван | ночь

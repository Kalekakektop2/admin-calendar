# Supabase Configuration
# Получите эти значения из вашего Supabase проекта: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role — ТОЛЬКО на сервере (Vercel / .env.local), НИКОГДА в NEXT_PUBLIC_
# Нужен для создания админов без выхода руководителя из аккаунта
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Sheets — расписание смен (CSV export)
# Вариант 1: полный URL экспорта CSV
# GOOGLE_SCHEDULE_CSV_URL=https://docs.google.com/spreadsheets/d/XXXX/export?format=csv&gid=0
#
# Вариант 2: ID таблицы (таблица должна быть «Все, у кого есть ссылка» → Читатель)
# GOOGLE_SCHEDULE_SHEET_ID=1pHFJ02udAaFvCHw8yb42o4T7F0jqPpBVSMSPW_4F_z4
# GOOGLE_SCHEDULE_SHEET_GID=1289606171
#
# Формат листа (колонки A B C, остальное игнор):
# A=дата (01.07.2026), B=интервал (09:00 - 21:00 | 21:00 - 09:00), C=имя (Диана, Влад, Макс П…)
# Ночная строка: A пустая, B=21:00-09:00, C=имя
